					<SimpleData name="Location">Launceston South</SimpleData>
					<SimpleData name="Grantee">Telstra</SimpleData>
					<SimpleData name="State">TAS</SimpleData>
					<SimpleData name="Electorate (2022)">Bass</SimpleData>
					<SimpleData name="Local Government Area">Launceston</SimpleData>
					<SimpleData name="Upgrade Type">Portable Generator</SimpleData>
					<SimpleData name="Description">Portable generator setup deployed at a local Telstra depot that can be quickly deployed within a 150km radius. Telstra has spaced the generators across the country to provide an appropriate degree of overlap. Each generator setup can provide a minimum of 24 hours capacity between refuelling. The deployment include one 25kVA trailer mounted generator to support a mobile base station and two 3.2kVA portable generators to support backhaul sites.</SimpleData>
					<SimpleData name="Site Status">Complete</SimpleData>
					<SimpleData name="Date Complete">20230630</SimpleData>
				</SchemaData>
			</ExtendedData>
			<Point>
				<coordinates>147.1509981,-41.459881378,0</coordinates>
			</Point>
		</Placemark>
